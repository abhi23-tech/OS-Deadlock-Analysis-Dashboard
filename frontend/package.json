{
  "name": "os-deadlock-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "node -e \"const fs=require('fs'); if(fs.existsSync('node_modules/@rollup/wasm-node')){fs.cpSync('node_modules/@rollup/wasm-node/dist/wasm-node','node_modules/rollup/dist/wasm-node',{recursive:true,force:true});fs.copyFileSync('node_modules/@rollup/wasm-node/dist/native.js','node_modules/rollup/dist/native.js');}\""
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.68.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  }
}